        <mxCell id="F3_MCP_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6f3d91;fontColor=#000000;fontSize=11;strokeWidth=1;align=left;spacingLeft=8;spacingTop=4;dashed=1;" value="&lt;b&gt;Claude Code 専用の通訳&lt;/b&gt;。&lt;br&gt;experience_search 等の道具を AI に渡す。&lt;br&gt;npm から自動アップデートされる。" vertex="1">
