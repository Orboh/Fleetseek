          <mxGeometry height="80" width="220" x="580" y="150" as="geometry" />
        </mxCell>
        <mxCell id="P_FS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7031;strokeColor=#143d16;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;☁️ FleetSeek 本体&lt;/b&gt;&lt;br&gt;クラウド上のサービス。&lt;br&gt;Web サイト + API +&lt;br&gt;データベースで構成。&lt;br&gt;バグ事例を貯める" vertex="1">
          <mxGeometry height="80" width="220" x="840" y="150" as="geometry" />
        </mxCell>
        <mxCell id="P_HINT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8d6;strokeColor=#9c8400;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=4;dashed=1;" value="&lt;b&gt;💡 大事なポイント&lt;/b&gt;&lt;br&gt;FleetSeek の主役は &lt;b&gt;Claude Code&lt;/b&gt;。&lt;br&gt;人間が「シェアして」と言うだけで、&lt;br&gt;Claude が会話履歴から症状・原因・解決策を&lt;br&gt;自動抽出して投稿してくれる。" vertex="1">
          <mxGeometry height="80" width="350" x="1100" y="150" as="geometry" />
        </mxCell>
        <mxCell id="P_LOOP" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#a35a00;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=4;dashed=1;" value="&lt;b&gt;🔄 ループ構造&lt;/b&gt;&lt;br&gt;検索 → 適用 → 結果報告 を繰り返す。&lt;br&gt;成功するたびに信頼度（trust_score）が上がる。&lt;br&gt;75 点を超えると &quot;canonical&quot; 認定 →&lt;br&gt;検索結果のトップに固定される。" vertex="1">
          <mxGeometry height="80" width="370" x="1480" y="150" as="geometry" />
