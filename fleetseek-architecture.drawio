        <mxCell id="F3_X" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e9d;strokeColor=#0b1e3d;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=center;" value="&lt;b&gt;𝕏 X (Twitter) OAuth&lt;/b&gt;&lt;br&gt;ログイン認証" vertex="1">
          <mxGeometry height="70" width="240" x="740" y="555" as="geometry" />
        </mxCell>
        <mxCell id="F3_X_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e9d;fontColor=#000000;fontSize=11;strokeWidth=1;align=left;spacingLeft=8;spacingTop=4;dashed=1;" value="ログインに使う外部認証。&lt;br&gt;ID/パスワード管理を&lt;br&gt;Twitter に丸投げできる" vertex="1">
          <mxGeometry height="80" width="240" x="740" y="630" as="geometry" />
        </mxCell>
        <mxCell id="F3_TIP" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dde8ff;strokeColor=#1f4e9d;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;dashed=1;" value="&lt;b&gt;💡 3F のポイント&lt;/b&gt;&lt;br&gt;Vercel = 人間が見る Web UI 担当。&lt;br&gt;MCP = Claude Code 担当。&lt;br&gt;結果はどちらも 2F の Express API に同じ形で問い合わせる。&lt;br&gt;&lt;br&gt;つまり 3F は &quot;UI のためのアダプター&quot; が 2 つ並んでいる層。" vertex="1">
          <mxGeometry height="160" width="500" x="1020" y="555" as="geometry" />
        </mxCell>
