  <diagram id="fleetseek-install" name="2. Install &amp; Update Flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TITLE" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" value="FleetSeek — ユーザーのインストール → アップデート手順" vertex="1">
          <mxGeometry height="40" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="LANEA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1f4e9d;arcSize=2;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="340" width="1700" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="LANEA_T" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#0b1e3d;" value="Step 1〜5 ─ 初回インストール（ユーザー操作）" vertex="1">
          <mxGeometry height="30" width="600" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="S1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9c8400;strokeColor=#4a3e00;fontColor=#ffffff;fontSize=12;strokeWidth=2;" value="&lt;b&gt;1. 1 行インストール&lt;/b&gt;&lt;br&gt;&lt;br&gt;curl -s&lt;br&gt;https://www.orboh.com/install.sh&lt;br&gt;| bash&lt;br&gt;&lt;br&gt;install.sh が CLI と MCP を一括導入" vertex="1">
          <mxGeometry height="180" width="280" x="80" y="160" as="geometry" />
        </mxCell>
        <mxCell id="S2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a8202b;strokeColor=#460c11;fontColor=#ffffff;fontSize=12;strokeWidth=2;" value="&lt;b&gt;2. CLI を npm から取得&lt;/b&gt;&lt;br&gt;&lt;br&gt;npm install -g&lt;br&gt;@orboh_jp/fleetseek-cli@latest&lt;br&gt;&lt;br&gt;グローバルに fleetseek コマンドが入る" vertex="1">
          <mxGeometry height="180" width="280" x="420" y="160" as="geometry" />
        </mxCell>
        <mxCell id="S3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6f3d91;strokeColor=#2e1742;fontColor=#ffffff;fontSize=12;strokeWidth=2;" value="&lt;b&gt;3. MCP サーバーを先読み&lt;/b&gt;&lt;br&gt;&lt;br&gt;npx -y&lt;br&gt;@orboh_jp/fleetseek-mcp@latest&lt;br&gt;&lt;br&gt;npx キャッシュを温めて&lt;br&gt;初回起動を高速化" vertex="1">
          <mxGeometry height="180" width="280" x="760" y="160" as="geometry" />
        </mxCell>
        <mxCell id="S4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7031;strokeColor=#143d16;fontColor=#ffffff;fontSize=12;strokeWidth=2;" value="&lt;b&gt;4. ログイン &amp; ロボット登録&lt;/b&gt;&lt;br&gt;&lt;br&gt;fleetseek auth login&lt;br&gt;  (X OAuth コールバック)&lt;br&gt;fleetseek robot register&lt;br&gt;&lt;br&gt;~/.config/fleetseek/config.json&lt;br&gt;に api_key と robot_id を保存" vertex="1">
          <mxGeometry height="200" width="280" x="1100" y="150" as="geometry" />
        </mxCell>
        <mxCell id="S5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6f3d91;strokeColor=#2e1742;fontColor=#ffffff;fontSize=12;strokeWidth=2;" value="&lt;b&gt;5. ~/.claude.json を更新&lt;/b&gt;&lt;br&gt;&lt;br&gt;mcpServers.fleetseek を追記:&lt;br&gt;・command: npx&lt;br&gt;・args: -y &lt;i&gt;...mcp@latest&lt;/i&gt;&lt;br&gt;・env: API_URL / API_KEY / ROBOT_ID&lt;br&gt;&lt;br&gt;Claude Code 再起動で接続完了" vertex="1">
          <mxGeometry height="200" width="280" x="1440" y="150" as="geometry" />
        </mxCell>
        <mxCell id="A12" edge="1" parent="1" source="S1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=3;endArrow=classicThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="S2">
