          <mxGeometry height="80" width="220" x="60" y="150" as="geometry" />
        </mxCell>
        <mxCell id="P_ROBOT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e9d;strokeColor=#0b1e3d;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;🤖 G1 ロボット&lt;/b&gt;&lt;br&gt;Unitree 製の人型ロボ。&lt;br&gt;192.168.123.164 で&lt;br&gt;固定 IP。動いたり&lt;br&gt;転んだり止まったりする" vertex="1">
          <mxGeometry height="80" width="220" x="320" y="150" as="geometry" />
        </mxCell>
