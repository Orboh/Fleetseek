          <mxGeometry height="30" width="700" x="60" y="725" as="geometry" />
        </mxCell>
        <mxCell id="F2_BG" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6e8c0;strokeColor=#2e7031;arcSize=2;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="180" width="1900" x="40" y="755" as="geometry" />
        </mxCell>
        <mxCell id="F2_API" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7031;strokeColor=#143d16;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;🚂 Express API (Railway)&lt;/b&gt;&lt;br&gt;robonet-api-production.up.railway.app&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;ここが受付窓口。すべてのリクエストはここを通る:&lt;br&gt;・POST /experiences         → バグ事例を 1 件登録&lt;br&gt;・POST /experiences/search  → 検索する&lt;br&gt;・POST /experiences/:id/applications → 「試した結果」を報告&lt;br&gt;・POST /robots/register     → ロボットを登録 (rbt_XXXX 発行)" vertex="1">
          <mxGeometry height="170" width="800" x="60" y="765" as="geometry" />
        </mxCell>
        <mxCell id="F2_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7031;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;dashed=1;" value="&lt;b&gt;💡 2F の役割&lt;/b&gt;&lt;br&gt;ここが &lt;b&gt;司令塔&lt;/b&gt;。&lt;br&gt;&lt;br&gt;3F のどの窓口（Vercel か MCP か）から来ても&lt;br&gt;最終的にこの API に &quot;同じ言語&quot; で問い合わせる。&lt;br&gt;&lt;br&gt;&lt;b&gt;Bearer 認証&lt;/b&gt;: API キー (robonet_XXX) を&lt;br&gt;Authorization ヘッダーに付けて送る&lt;br&gt;&lt;br&gt;&lt;b&gt;1F へ問い合わせる係&lt;/b&gt;: SQL を組み立てて&lt;br&gt;PostgreSQL からデータを取り出す" vertex="1">
          <mxGeometry height="170" width="350" x="900" y="765" as="geometry" />
        </mxCell>
        <mxCell id="F2_HOSTING" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dde8ff;strokeColor=#1f4e9d;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;dashed=1;" value="&lt;b&gt;🚂 Railway とは&lt;/b&gt;&lt;br&gt;クラウドホスティングサービス。&lt;br&gt;Heroku に近い。&lt;br&gt;&lt;br&gt;FleetSeek は API サーバーと&lt;br&gt;PostgreSQL データベースの&lt;br&gt;両方を Railway 上で動かしている。&lt;br&gt;&lt;br&gt;deploy: &lt;br&gt;`railway up --service robonet-api`" vertex="1">
          <mxGeometry height="200" width="280" x="1280" y="755" as="geometry" />
        </mxCell>
        <mxCell id="F2_AUTH" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5cc;strokeColor=#9c8400;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;dashed=1;" value="&lt;b&gt;🔐 認証の仕組み&lt;/b&gt;&lt;br&gt;1. X でログイン (3F の Vercel 経由)&lt;br&gt;2. API が `robonet_XXXX` を発行&lt;br&gt;3. CLI/MCP/SDK は全リクエストに&lt;br&gt;   `Authorization: Bearer robonet_XXX`&lt;br&gt;   を必ず付ける&lt;br&gt;&lt;br&gt;キーは ~/.config/fleetseek/&lt;br&gt;config.json に保存される" vertex="1">
          <mxGeometry height="200" width="290" x="1580" y="755" as="geometry" />
        </mxCell>
        <mxCell id="F1_LABEL" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#a35a00;" value="🏢 1F  データ保管層（ぜんぶ覚えてる場所）" vertex="1">
          <mxGeometry height="30" width="700" x="60" y="965" as="geometry" />
        </mxCell>
        <mxCell id="F1_BG" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#a35a00;arcSize=2;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="220" width="1900" x="40" y="995" as="geometry" />
        </mxCell>
        <mxCell id="F1_PG" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#a35a00;strokeColor=#3d2200;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=center;" value="&lt;b&gt;💾 PostgreSQL 16&lt;/b&gt;&lt;br&gt;+ pgvector" vertex="1">
          <mxGeometry height="100" width="280" x="60" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="F1_PG_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35a00;fontColor=#000000;fontSize=11;strokeWidth=1;align=left;spacingLeft=8;spacingTop=4;dashed=1;" value="&lt;b&gt;ここに全部の記憶が入る&lt;/b&gt;&lt;br&gt;・experiences (バグ事例の本体)&lt;br&gt;・robots (ロボット個体)&lt;br&gt;・experience_applications (適用結果)&lt;br&gt;・config_snapshots (ロボの設定履歴)&lt;br&gt;&lt;br&gt;pgvector = ベクトル検索用拡張" vertex="1">
          <mxGeometry height="160" width="280" x="60" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="F1_OAI" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a35a00;strokeColor=#3d2200;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=center;" value="&lt;b&gt;🤖 OpenAI API&lt;/b&gt;&lt;br&gt;text-embedding-3-small" vertex="1">
          <mxGeometry height="80" width="240" x="380" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="F1_OAI_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35a00;fontColor=#000000;fontSize=11;strokeWidth=1;align=left;spacingLeft=8;spacingTop=4;dashed=1;" value="&lt;b&gt;意味検索の助っ人&lt;/b&gt;&lt;br&gt;「腕が振動」と&lt;br&gt;「アームが揺れる」が&lt;br&gt;同じ意味だと分かるよう&lt;br&gt;文章 → 1536 次元ベクトルに変換" vertex="1">
          <mxGeometry height="160" width="240" x="380" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="F1_NPM" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a35a00;strokeColor=#3d2200;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=center;" value="&lt;b&gt;📦 npm registry&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="660" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="F1_NPM_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35a00;fontColor=#000000;fontSize=11;strokeWidth=1;align=left;spacingLeft=8;spacingTop=4;dashed=1;" value="&lt;b&gt;CLI/MCP の配信元&lt;/b&gt;&lt;br&gt;・@orboh_jp/fleetseek-cli&lt;br&gt;・@orboh_jp/fleetseek-mcp&lt;br&gt;&lt;br&gt;Claude Code 再起動で&lt;br&gt;@latest が自動取得される" vertex="1">
          <mxGeometry height="160" width="240" x="660" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="F1_OBS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a35a00;strokeColor=#3d2200;fontColor=#ffffff;fontSize=12;strokeWidth=2;align=center;" value="&lt;b&gt;📓 Obsidian Vault&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="940" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="F1_OBS_NOTE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35a00;fontColor=#000000;fontSize=11;strokeWidth=1;align=left;spacingLeft=8;spacingTop=4;dashed=1;" value="&lt;b&gt;Orboh 社内 DB&lt;/b&gt;&lt;br&gt;Dev-Log / 要件定義&lt;br&gt;ローカルのマークダウン集。&lt;br&gt;FleetSeek の URL も&lt;br&gt;ここに記録される" vertex="1">
          <mxGeometry height="160" width="240" x="940" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="F1_DATA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#a35a00;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;dashed=1;" value="&lt;b&gt;💡 Experience（記事）の中身イメージ&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;id: &quot;exp_01ABC...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;type: &quot;debug_note&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;title: &quot;G1 の腕が振動する&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;data: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;symptoms: { 観測した動き: &quot;1Hzで揺れる&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;root_cause: &quot;Kdゲインが高い&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;resolution: { steps: [&quot;Kdを30→15&quot;] }&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;trust_score: 87  ← &lt;b&gt;成功するほど自動で増える&lt;/b&gt;&lt;br&gt;}" vertex="1">
          <mxGeometry height="240" width="430" x="1230" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="F1_TRUST" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#a35a00;fontColor=#000000;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;dashed=1;" value="&lt;b&gt;💯 trust_score の育ち方&lt;/b&gt;&lt;br&gt;新規投稿: 50 点スタート&lt;br&gt;誰かが試して成功 → +α&lt;br&gt;誰かが試して失敗 → −α&lt;br&gt;&lt;br&gt;&lt;b&gt;Bayesian 平均&lt;/b&gt;で計算。&lt;br&gt;75 点超えで &quot;canonical&quot; 認定&lt;br&gt;→ 検索結果の先頭に固定&lt;br&gt;&lt;br&gt;&lt;b&gt;失敗報告も価値がある&lt;/b&gt;。&lt;br&gt;嘘の解決策が放置されないため。" vertex="1">
          <mxGeometry height="240" width="220" x="1680" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="ARROW_FLOW" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#444444;" value="📥 上から下へ &quot;質問&quot; が降りていき、💾 1F の答えが上へ返る ─ それだけのシンプルな構造です" vertex="1">
          <mxGeometry height="30" width="1500" x="60" y="1280" as="geometry" />
        </mxCell>
